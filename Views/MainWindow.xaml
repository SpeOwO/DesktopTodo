<Window x:Class="DesktopTodoCalendar.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DesktopTodoCalendar.Views"
        xmlns:vm="clr-namespace:DesktopTodoCalendar.ViewModels"
        mc:Ignorable="d"
        Title="Desktop Todo Calendar" Height="600" Width="800"
        
        <!-- 바탕화면 위젯 핵심 설정 -->
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="#CC1E1E1E" 
        ShowInTaskbar="False"
        Topmost="False"
        
        <!-- 창을 마우스로 드래그해서 옮길 수 있게 하는 이벤트 -->
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/> <!-- 달력 영역 -->
            <ColumnDefinition Width="*"/>   <!-- 투두 리스트 영역 -->
        </Grid.ColumnDefinitions>

        <!-- 왼쪽: 달력 뷰 -->
        <Border Grid.Column="0" Background="#33FFFFFF" CornerRadius="10" Padding="10" Margin="0,0,10,0">
            <StackPanel>
                <TextBlock Text="Calendar" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                
                <!-- WPF 기본 달력 컨트롤. ViewModel의 SelectedDate와 양방향 연결됨 -->
                <Calendar SelectedDate="{Binding SelectedDate, Mode=TwoWay}" 
                          Background="Transparent" BorderBrush="Transparent" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- 오른쪽: 리스트 뷰 -->
        <Border Grid.Column="1" Background="#33FFFFFF" CornerRadius="10" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="{Binding SelectedDate, StringFormat='{}{0:yyyy년 MM월 dd일}'}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text=" 의 할 일" Foreground="LightGray" FontSize="24"/>
                </StackPanel>

                <!-- 투두 리스트 항목들 -->
                <ListView Grid.Row="1" ItemsSource="{Binding CurrentTodos}" 
                          Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#44000000" CornerRadius="5" Margin="0,0,0,8" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- 컬러 태그 -->
                                    <Rectangle Grid.Column="0" Width="4" Height="20" Fill="{Binding ColorTag}" RadiusX="2" RadiusY="2" Margin="0,0,10,0"/>
                                    
                                    <!-- 업무 제목 -->
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                                    
                                    <!-- 상태 표시 (간이 콤보박스 형태) -->
                                    <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="LightSkyBlue" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 새 업무 추가 버튼 (기능은 나중에 연결) -->
                <Button Grid.Row="2" Content="+ 업무 추가" Height="40" Background="#4CAF50" Foreground="White" 
                        FontSize="16" FontWeight="Bold" Margin="0,15,0,0" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>