<Window x:Class="DesktopTodo.Views.TodoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="할 일 편집" Height="550" Width="430"
        MinHeight="450" MinWidth="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid>
        <Border Background="#2C2C2C" BorderBrush="#555555" BorderThickness="1" CornerRadius="10" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: 타이틀 -->
                    <RowDefinition Height="Auto"/> <!-- 1: 기간 설정 라벨 (NEW) -->
                    <RowDefinition Height="Auto"/> <!-- 2: 날짜 선택기 (NEW) -->
                    <RowDefinition Height="Auto"/> <!-- 3: 제목 라벨 -->
                    <RowDefinition Height="Auto"/> <!-- 4: 제목 텍스트박스 -->
                    <RowDefinition Height="Auto"/> <!-- 5: 상태 및 범위 콤보박스 -->
                    <RowDefinition Height="Auto"/> <!-- 6: 메모 라벨 -->
                    <RowDefinition Height="*"/>    <!-- 7: 메모 텍스트박스 -->
                    <RowDefinition Height="Auto"/> <!-- 8: 색상 선택 -->
                    <RowDefinition Height="Auto"/> <!-- 9: 하단 버튼 -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding PopupTitle}" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                
                <!-- 기간 설정 영역 추가 -->
                <TextBlock Grid.Row="1" Text="기간 설정 (시작일 ~ 종료일)" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
                    <DatePicker SelectedDate="{Binding NewTodoDate}" Width="120" Height="26" VerticalContentAlignment="Center" Background="#1E1E1E"/>
                    <TextBlock Text=" ~ " Foreground="White" VerticalAlignment="Center" Margin="10,0"/>
                    <DatePicker SelectedDate="{Binding NewTodoEndDate}" Width="120" Height="26" VerticalContentAlignment="Center" Background="#1E1E1E"/>
                </StackPanel>
                
                <TextBlock Grid.Row="3" Text="업무 제목" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                <TextBox Grid.Row="4" Text="{Binding NewTodoTitle, UpdateSourceTrigger=PropertyChanged}" Background="#1E1E1E" Foreground="White" BorderBrush="#555555" Padding="5" FontSize="14" Margin="0,0,0,15"/>
                
                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="진행 상태" Foreground="Gray" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox ItemsSource="{Binding AvailableStates}" SelectedItem="{Binding NewTodoState}" Width="100" Padding="5" Margin="0,0,20,0"/>
                    
                    <TextBlock Text="적용 범위" Foreground="Gray" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox ItemsSource="{Binding AvailableScopes}" SelectedItem="{Binding NewTodoScope}" Width="100" Padding="5"/>
                </StackPanel>
                
                <TextBlock Grid.Row="6" Text="상세 내용 (메모)" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                <TextBox Grid.Row="7" Text="{Binding NewTodoMemo, UpdateSourceTrigger=PropertyChanged}" 
                         Background="#1E1E1E" Foreground="White" BorderBrush="#555555" Padding="5" FontSize="14" Margin="0,0,0,15"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch"/>
                
                <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="색상 태그" Foreground="Gray" FontSize="12" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Rectangle Width="20" Height="20" Fill="{Binding SelectedColorTag}" RadiusX="10" RadiusY="10" Margin="0,0,15,0" Stroke="White" StrokeThickness="2"/>
                    
                    <ItemsControl ItemsSource="{Binding AvailableColors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="20" Height="20" Background="{Binding}" Margin="0,0,8,0" Click="Color_Click" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Rectangle Fill="{TemplateBinding Background}" RadiusX="10" RadiusY="10"/>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                
                <Grid Grid.Row="9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Content="삭제" Click="DeleteTodo_Click" Background="#FF4C4C" Foreground="White" BorderThickness="0" Padding="15,10" Cursor="Hand" FontSize="14">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                    </Button>

                    <Button Grid.Column="2" Content="취소" Click="CancelTodo_Click" Background="#444444" Foreground="White" BorderThickness="0" Padding="0,10" Cursor="Hand" FontSize="14">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                    </Button>
                    <Button Grid.Column="4" Content="저장" Click="SaveTodo_Click" Background="#4CAF50" Foreground="White" BorderThickness="0" Padding="0,10" Cursor="Hand" FontWeight="Bold" FontSize="14">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Thumb Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="ResizeCorner_DragDelta" Background="Transparent">
            <Thumb.Template>
                <ControlTemplate>
                    <Grid Background="Transparent">
                        <Path Data="M 16,0 L 16,16 L 0,16 Z" Fill="#55FFFFFF" Margin="0,0,2,2"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>