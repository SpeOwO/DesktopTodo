<Window x:Class="DesktopTodo.Views.TodoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="업무 추가" Height="650" Width="430"
        MinHeight="550" MinWidth="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- 에러 방지를 위해 독립적인 리소스 정의 추가 -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Border Background="#2C2C2C" BorderBrush="#555555" BorderThickness="1" CornerRadius="10" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: 종류 선택 탭 -->
                    <RowDefinition Height="Auto"/> <!-- 1: 타이틀 -->
                    <RowDefinition Height="Auto"/> <!-- 2: 기간 설정 -->
                    <RowDefinition Height="Auto"/> <!-- 3: 루틴 설정 -->
                    <RowDefinition Height="Auto"/> <!-- 4: 제목 라벨 -->
                    <RowDefinition Height="Auto"/> <!-- 5: 제목 텍스트박스 -->
                    <RowDefinition Height="Auto"/> <!-- 6: 상태 및 범위, 이월 -->
                    <RowDefinition Height="*"/>    <!-- 7: 하위 태스크 / 메모 -->
                    <RowDefinition Height="Auto"/> <!-- 8: 색상 선택 -->
                    <RowDefinition Height="Auto"/> <!-- 9: 하단 버튼 -->
                </Grid.RowDefinitions>

                <!-- 0: 업무 종류 선택 탭 (에러의 원인이었던 IsEnabled 바인딩을 안전한 Style Trigger로 교체) -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="IsEnabled" Value="True"/>
                            <!-- 수정 모드(IsEditing=True)일 때는 탭 클릭(종류 변경)을 막음 -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="일반 할 일" Click="TabSingle_Click" Margin="0,0,5,0" Padding="0,8" Cursor="Hand" Background="#333" Foreground="White" BorderThickness="0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                    </Button>
                    <Button Grid.Column="1" Content="프로젝트" Click="TabProject_Click" Margin="2,0,2,0" Padding="0,8" Cursor="Hand" Background="#333" Foreground="White" BorderThickness="0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                    </Button>
                    <Button Grid.Column="2" Content="반복 루틴" Click="TabRoutine_Click" Margin="5,0,0,0" Padding="0,8" Cursor="Hand" Background="#333" Foreground="White" BorderThickness="0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                    </Button>
                </Grid>

                <TextBlock Grid.Row="1" Text="{Binding PopupTitle}" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                
                <!-- 2: 기간 설정 (루틴이 아닐 때만 보임) -->
                <StackPanel Grid.Row="2" Margin="0,0,0,15">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentEditTaskType}" Value="Routine">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="기간 설정 (시작일 ~ 종료일)" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding NewTodoDate}" Width="120" Height="26" VerticalContentAlignment="Center" Background="#1E1E1E"/>
                        <TextBlock Text=" ~ " Foreground="White" VerticalAlignment="Center" Margin="10,0"/>
                        <DatePicker SelectedDate="{Binding NewTodoEndDate}" Width="120" Height="26" VerticalContentAlignment="Center" Background="#1E1E1E"/>
                    </StackPanel>
                </StackPanel>

                <!-- 3: 루틴 설정 영역 (루틴일 때만 보임) -->
                <StackPanel Grid.Row="3" Margin="0,0,0,15">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentEditTaskType}" Value="Routine">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="반복 주기 선택" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding AvailableRoutineTypes}" SelectedItem="{Binding SelectedRoutineType}" Width="120" Padding="5" HorizontalAlignment="Left"/>
                </StackPanel>
                
                <TextBlock Grid.Row="4" Text="업무 제목" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                <TextBox Grid.Row="5" Text="{Binding NewTodoTitle, UpdateSourceTrigger=PropertyChanged}" Background="#1E1E1E" Foreground="White" BorderBrush="#555555" Padding="5" FontSize="14" Margin="0,0,0,15"/>
                
                <!-- 6: 상태, 범위, 이월 -->
                <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentEditTaskType}" Value="Routine">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="진행 상태" Foreground="Gray" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding AvailableStates}" SelectedItem="{Binding NewTodoState}" Width="100" Padding="5" Margin="0,0,20,0"/>
                        
                        <TextBlock Text="적용 범위" Foreground="Gray" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding AvailableScopes}" SelectedItem="{Binding NewTodoScope}" Width="80" Padding="5" Margin="0,0,20,0"/>
                    </StackPanel>
                    
                    <CheckBox Content="미완료 시 다음날로 이월" IsChecked="{Binding IsRolloverEnabled}" Foreground="White" VerticalAlignment="Center" Cursor="Hand"/>
                </StackPanel>
                
                <!-- 7: 상세 메모 및 하위 체크리스트 -->
                <Grid Grid.Row="7" Margin="0,0,0,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/> 
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/> 
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="상세 내용 (메모)" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox Grid.Row="1" Text="{Binding NewTodoMemo, UpdateSourceTrigger=PropertyChanged}" Background="#1E1E1E" Foreground="White" BorderBrush="#555555" Padding="5" FontSize="14" Margin="0,0,0,10" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch" MinHeight="50"/>

                    <StackPanel Grid.Row="2" Margin="0,5,0,5">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding CurrentEditTaskType}" Value="Project"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="하위 체크리스트 (프로젝트용)" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NewSubTaskTitle, UpdateSourceTrigger=PropertyChanged}" Background="#1E1E1E" Foreground="White" BorderBrush="#555555" Padding="5" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="추가" Click="AddSubTask_Click" Background="#4DABF7" Foreground="White" BorderThickness="0" Padding="0,5" Cursor="Hand"><Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style></Button.Resources></Button>
                        </Grid>
                    </StackPanel>

                    <ListBox Grid.Row="3" ItemsSource="{Binding SubTasks}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding CurrentEditTaskType}" Value="Project"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Title}" IsChecked="{Binding IsDone}" Foreground="White" Margin="0,2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                
                <!-- 8: 색상 태그 선택 -->
                <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="색상 태그" Foreground="Gray" FontSize="12" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <ListBox ItemsSource="{Binding AvailableColors}" SelectedItem="{Binding SelectedColorTag}" 
                             Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,8,0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="SelectionBorder" Width="26" Height="26" CornerRadius="13" BorderThickness="2" BorderBrush="Transparent" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Rectangle Fill="{Binding}" Width="18" Height="18" RadiusX="9" RadiusY="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionBorder" Property="BorderBrush" Value="White"/></Trigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#66FFFFFF"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </StackPanel>
                
                <!-- 9: 하단 버튼 -->
                <Grid Grid.Row="9">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="10"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Content="삭제" Click="DeleteTodo_Click" Background="#FF4C4C" Foreground="White" BorderThickness="0" Padding="15,10" Cursor="Hand" FontSize="14">
                        <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                    </Button>

                    <Button Grid.Column="2" Content="취소" Click="CancelTodo_Click" Background="#444444" Foreground="White" BorderThickness="0" Padding="0,10" Cursor="Hand" FontSize="14">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                    </Button>
                    <Button Grid.Column="4" Content="저장" Click="SaveTodo_Click" Background="#4CAF50" Foreground="White" BorderThickness="0" Padding="0,10" Cursor="Hand" FontWeight="Bold" FontSize="14">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Thumb Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="ResizeCorner_DragDelta" Background="Transparent">
            <Thumb.Template><ControlTemplate><Grid Background="Transparent"><Path Data="M 16,0 L 16,16 L 0,16 Z" Fill="#55FFFFFF" Margin="0,0,2,2"/></Grid></ControlTemplate></Thumb.Template>
        </Thumb>
    </Grid>
</Window>